{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "id": "46698586-e643-462a-95a0-5af6ff73ceca",
  "version": "1.0.2",
  "name": {
    "short": "iLA",
    "full": "iLA - iLoveAccounting for Outlook"
  },
  "description": {
    "short": "Turn emailed DDTAs into Lightyear bills.",
    "full": "iLA reads the open email, builds an AP invoice for each attached DDTA, joins it to the DDTA scan and emails each one to Lightyear."
  },
  "developer": {
    "name": "AFIS Consultancy Pty Ltd",
    "websiteUrl": "https://ila.works",
    "privacyUrl": "https://ila.works/privacy",
    "termsOfUseUrl": "https://ila.works/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#0F52BA",
  "localizationInfo": {
    "defaultLanguageTag": "en-au",
    "additionalLanguages": []
  },
  "validDomains": [
    "yyi921.github.io"
  ],
  "showLoadingIndicator": false,
  "isFullScreen": false,
  "defaultBlockUntilAdminAction": false,
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "MailboxItem.Read.User",
          "type": "Delegated"
        }
      ]
    }
  },
  "extensions": [
    {
      "requirements": {
        "scopes": [
          "mail"
        ],
        "capabilities": [
          {
            "name": "Mailbox",
            "minVersion": "1.8"
          }
        ]
      },
      "runtimes": [
        {
          "requirements": {
            "capabilities": [
              {
                "name": "Mailbox",
                "minVersion": "1.8"
              }
            ]
          },
          "id": "TaskPaneRuntime",
          "type": "general",
          "code": {
            "page": "https://yyi921.github.io/ila-outlook-addin/taskpane.html"
          },
          "lifetime": "short",
          "actions": [
            {
              "id": "TaskPaneRuntimeShow",
              "type": "openPage",
              "pinnable": true
            }
          ]
        }
      ],
      "ribbons": [
        {
          "contexts": [
            "mailRead"
          ],
          "tabs": [
            {
              "builtInTabId": "TabDefault",
              "groups": [
                {
                  "id": "ilaReadGroup",
                  "label": "iLA",
                  "icons": [
                    {
                      "size": 16,
                      "url": "https://yyi921.github.io/ila-outlook-addin/assets/icon-16.png"
                    },
                    {
                      "size": 32,
                      "url": "https://yyi921.github.io/ila-outlook-addin/assets/icon-32.png"
                    },
                    {
                      "size": 80,
                      "url": "https://yyi921.github.io/ila-outlook-addin/assets/icon-80.png"
                    }
                  ],
                  "controls": [
                    {
                      "id": "ilaOpenPane",
                      "type": "button",
                      "label": "Open iLA",
                      "icons": [
                        {
                          "size": 16,
                          "url": "https://yyi921.github.io/ila-outlook-addin/assets/icon-16.png"
                        },
                        {
                          "size": 32,
                          "url": "https://yyi921.github.io/ila-outlook-addin/assets/icon-32.png"
                        },
                        {
                          "size": 80,
                          "url": "https://yyi921.github.io/ila-outlook-addin/assets/icon-80.png"
                        }
                      ],
                      "supertip": {
                        "title": "Open iLA",
                        "description": "Send the DDTAs attached to this email to Lightyear."
                      },
                      "actionId": "TaskPaneRuntimeShow"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}